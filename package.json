{
  "name": "directus_bundle_collection_clone",
  "description": "Clone collections in Directus",
  "icon": "copy_all",
  "version": "1.0.0",
  "keywords": [
    "collection",
    "copy",
    "clone",
    "collection clone",
    "clone collection",
    "directus",
    "directus-extension",
    "directus-extension-bundle"
  ],
  "author": {
    "name": "Philipp Winterle",
    "email": "philipp.winterle@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/philipp-winterle/directus_extension_collection_clone.git"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "release": {
    "tagFormat": "v${version}",
    "branches": [
      "main",
      "next"
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits"
        }
      ],
      "@semantic-release/release-notes-generator",
      [
        "@semantic-release/npm",
        {
          "npmPublish": true
        }
      ],
      [
        "@semantic-release/git",
        {
          "assets": [
            "package.json"
          ],
          "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
        }
      ],
      "@semantic-release/github"
    ]
  },
  "directus:extension": {
    "type": "bundle",
    "path": {
      "app": "dist/app.js",
      "api": "dist/api.js"
    },
    "entries": [
      {
        "type": "endpoint",
        "name": "directus_endpoint_collection_clone",
        "source": "src/directus_endpoint_collection_clone/index.ts"
      },
      {
        "type": "module",
        "name": "directus_module_collection_clone",
        "source": "src/directus_module_collection_clone/index.ts"
      }
    ],
    "host": ">=11.0.0"
  },
  "scripts": {
    "build": "directus-extension build",
    "dev": "directus-extension build -w --no-minify",
    "link": "directus-extension link",
    "validate": "directus-extension validate",
    "add": "directus-extension add",
    "upgrade": "npx npm-check-updates -i --format group"
  },
  "devDependencies": {
    "@directus/extensions-sdk": "13.0.4",
    "@directus/types": "^13.1.0",
    "@semantic-release/git": "^10.0.1",
    "@types/node": "^22.14.1",
    "ansis": "^3.17.0",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "pino": "^9.6.0",
    "semantic-release": "^24.2.3",
    "typescript": "^5.8.3",
    "vue": "^3.5.13",
    "vue-final-modal": "^4.5.5",
    "vue-router": "^4.5.0"
  }
}
